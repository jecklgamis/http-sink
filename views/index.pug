extends layout

block content
  h1= title
  p.tagline Relax, sink it.
  p= message

  p: a(href='https://github.com/jecklgamis/http-sink' target='_blank' rel='noopener') View on GitHub
  div#docker-cmd-wrap
    pre
      code#docker-cmd.
        docker run --name http-sink -p 38080:38080 -it  jecklgamis/http-sink:main
    button#docker-cmd-copy(type='button' aria-label='Copy command' title='Copy command') 📋

  div#live-stats-section
    h3 Live Traffic Stats

    div#rps-sparkline-wrap
      div#rps-sparkline-row
        div#rps-sparkline-yaxis
          span#rps-yaxis-max
          span#rps-yaxis-75
          span#rps-yaxis-50
          span#rps-yaxis-25
          span 0
        svg#rps-sparkline(viewBox='0 0 300 100' preserveAspectRatio='none')
          g#rps-sparkline-grid
          polyline#rps-sparkline-line(points='' fill='none' stroke='#b2182b' stroke-width='2' vector-effect='non-scaling-stroke')
      div#rps-sparkline-axis
        span -30s
        span -15s
        span now

    table#sink-breakdown
      thead
        tr
          th Path
          th Method
          th RPS
      tbody#breakdown-body

  div#packet-inspection-section
    h3 Packet Inspection
    button#clear-recent Clear
    button#freeze-recent Freeze
    table#sink-recent
      thead
        tr
          th Time
          th Method
          th Path
          th Status
          th Response time (ms)
          th Remote address
          th User agent
          th Headers
          th Body
          th Response headers
          th Response body
      tbody#recent-body
    p.stats-updated#stats-updated updating...

  div#endpoints-section
    h3 Endpoints

    h4 Sink
    table#sink-endpoints-sink
      thead
        tr
          th Method
          th Path
          th Test
          th Description
      tbody
        tr
          td ALL
          td /sink, /sink/*
          td: button.curl-test(type='button' data-method='POST' data-path='/sink' data-body='{"hello":"world"}') Test it!
          td httpbin-style echo of method/path/headers/body/args/origin, with latency/failure injection applied first

    h4 Sink utilities
    table#sink-endpoints-utils
      thead
        tr
          th Method
          th Path
          th Test
          th Description
      tbody
        tr
          td GET
          td /sink/headers
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/headers') Test it!
          td Returns the request headers
        tr
          td GET
          td /sink/ip
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/ip') Test it!
          td Returns the caller's origin address
        tr
          td GET
          td /sink/user-agent
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/user-agent') Test it!
          td Returns the User-Agent header
        tr
          td GET
          td /sink/uuid
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/uuid') Test it!
          td Returns a random UUID
        tr
          td GET
          td /sink/status/:code
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/status/503') Test it!
          td Responds with the given status code (100-599)
        tr
          td GET
          td /sink/delay/:seconds
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/delay/2') Test it!
          td Delays the response by the given number of seconds (max 10)
        tr
          td GET
          td /sink/redirect/:n
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/redirect/3') Test it!
          td Redirects n times before responding (max 20)
        tr
          td GET
          td /sink/response-headers
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/response-headers?X-Foo=bar') Test it!
          td Echoes query params back as response headers
        tr
          td GET
          td /sink/stream/:n
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/stream/5') Test it!
          td Streams n JSON lines (max 100)
        tr
          td GET
          td /sink/bytes/:n
          td: button.curl-test(type='button' data-method='GET' data-path='/sink/bytes/32') Test it!
          td Returns n random bytes (max 100KB)

  div#project-section
    h3 Project

    p.section-info Found a bug or have feedback? Please raise an issue on #[a(href='https://github.com/jecklgamis/http-sink/issues' target='_blank' rel='noopener') GitHub].

    div#project-active(hidden)
      p
        | Active project:
        strong#project-active-name
        |  &mdash; use path prefix
        code#project-path-prefix
      button#project-forget Delete project

    p.section-info Latency/failure configs must live under /sink/&lt;project&gt;/... and require that project's token to create or remove, so your test paths can't collide with (or be broken by) anyone else's.

    h4 Existing projects
    table#sink-projects
      thead
        tr
          th Name
          th Created
      tbody#projects-body

    h4 Create
    p.section-info Claim a project name to get an API token, shown once.
    form#project-form
      input#project-name(type='text' placeholder='my-project' pattern='[a-zA-Z0-9_-]{1,64}' required)
      button(type='submit') Create project
    span.form-error#project-form-error

    h4 Set
    p.section-info Already have a project and token from before (different browser, cleared storage)? Restore it here instead of creating a new one.
    form#project-restore-form
      input#project-restore-name(type='text' placeholder='my-project' required)
      input#project-restore-token(type='text' placeholder='token' required)
      button(type='submit') Set
    span.form-error#project-restore-form-error

    h4 Delete
    p.section-info Delete a project by name and token &mdash; frees the name and removes any latency/failure configs under it. Works even if it isn't the active project in this browser.
    form#project-delete-form
      input#project-delete-name(type='text' placeholder='my-project' required)
      input#project-delete-token(type='text' placeholder='token' required)
      button(type='submit') Delete project
    span.form-error#project-delete-form-error

    div#project-token-reveal(hidden)
      p.section-info Save this token now &mdash; it will not be shown again.
      input#project-token(type='text' readonly)
      button#project-token-copy Copy

  div#latency-section
    h3 Latency Simulation
    p.section-info Configure a path under your project and a jitter value in ms. Requests to the exact path get a random delay between 0 and that value before responding. Requires your project token.
    form#latency-form
      input#latency-path(type='text' placeholder='/sink/my-project/foo' required)
      input#latency-jitter(type='number' placeholder='jitter ms' min='0' required)
      button(type='submit') Add
    span.form-error#latency-form-error
    table#sink-latency
      thead
        tr
          th Path
          th Jitter (ms)
          th
      tbody#latency-body

  div#failure-section
    h3 Failure Injection
    p.section-info Configure a path under your project, an error rate (0-1), and a status code. That fraction of requests to the exact path will receive the status code instead of the normal 200 response; the rest respond normally. Requires your project token.
    form#failure-form
      input#failure-path(type='text' placeholder='/sink/my-project/foo' list='failure-path-list' required)
      datalist#failure-path-list
      select#failure-rate(required)
        option(value='0.05') 5%
        option(value='0.1') 10%
        option(value='0.25') 25%
        option(value='0.5' selected) 50%
        option(value='0.75') 75%
        option(value='1') 100%
      select#failure-status(required)
        option(value='400') 400 Bad Request
        option(value='401') 401 Unauthorized
        option(value='403') 403 Forbidden
        option(value='404') 404 Not Found
        option(value='408') 408 Request Timeout
        option(value='429') 429 Too Many Requests
        option(value='500' selected) 500 Internal Server Error
        option(value='502') 502 Bad Gateway
        option(value='503') 503 Service Unavailable
        option(value='504') 504 Gateway Timeout
      button(type='submit') Add
    span.form-error#failure-form-error
    table#sink-failure
      thead
        tr
          th Path
          th Rate
          th Status code
          th
      tbody#failure-body

  div#chaos-preset-section
    h3 Chaos Presets
    p.section-info Apply a canned latency + failure combo to a path in one click, instead of configuring each separately. Requires your project token.
    div#chaos-preset-controls
      input#chaos-preset-path(type='text' placeholder='/sink/my-project/foo' required)
      button.chaos-preset(type='button' data-preset='flaky-network') Flaky network
      button.chaos-preset(type='button' data-preset='slow-db') Slow DB
      button.chaos-preset(type='button' data-preset='intermittent-5xx') Intermittent 5xx
    span.form-error#chaos-preset-error
    p.section-info
      | Flaky network: 0-500ms jitter, 15% chance of 503.
      br
      | Slow DB: 0-4000ms jitter, 5% chance of 504.
      br
      | Intermittent 5xx: no jitter, 30% chance of 500.

  div#response-template-section
    h3 Response Templates
    p.section-info Configure a path (and optionally a method) under your project with a fixed status code, optional headers, and optional JSON body. Requests to the exact path (and method, if set) get that response instead of the normal echo (failure injection, if also configured, still takes precedence). A template with no method matches any method; a method-specific template takes precedence over one for "Any". Requires your project token.
    form#response-template-form
      input#response-template-path(type='text' placeholder='/sink/my-project/foo' required)
      select#response-template-method
        option(value='') Any method
        option(value='GET') GET
        option(value='POST') POST
        option(value='PUT') PUT
        option(value='DELETE') DELETE
        option(value='PATCH') PATCH
        option(value='HEAD') HEAD
        option(value='OPTIONS') OPTIONS
      input#response-template-status(type='number' placeholder='status code' min='100' max='599' value='200' required)
      textarea#response-template-headers(rows='6').
        {
          "X-Request-Id": "a1b2c3d4",
          "Cache-Control": "no-store"
        }
      textarea#response-template-body-input(rows='10').
        {
          "orderId": 9981,
          "status": "shipped",
          "items": [{"sku": "WIDGET-42", "qty": 3}],
          "total": 59.97
        }
      button(type='submit') Add
    span.form-error#response-template-form-error
    table#sink-response-template
      thead
        tr
          th Path
          th Method
          th Status code
          th Headers
          th Body
          th
      tbody#response-template-list-body

  div#unique-ips-section
    h3 Client IPs
    p.section-info#unique-ips-info Origin addresses seen in the last 30s of traffic.
    table#sink-unique-ips
      thead
        tr
          th IP
          th Requests
          th Last seen
      tbody#unique-ips-body

  script(src='/javascripts/sink-stats.js')
